@echo off
chcp 65001 >nul
REM ══════════════════════════════════════════════════════════════
REM  V88 夜间重启遥控 — 2026-07-30
REM  由任务计划程序在北京时间 03:30 调用（撞 V88 维护时间窗 03:00-04:30）。
REM
REM  为什么需要：遥控常驻V88.bat 只在「每次启动时」拉代码。
REM  进程一挂就是好几天，代码会越跑越旧。夜里踢一次 = 强制拿最新代码 + 换新会话。
REM ══════════════════════════════════════════════════════════════

schtasks /end /tn "V88-遥控常驻" >nul 2>&1
timeout /t 10 /nobreak >nul
schtasks /run /tn "V88-遥控常驻" >nul 2>&1
